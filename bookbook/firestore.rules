rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validRecord(uid) {
      let d = request.resource.data;
      return d.userId == uid && d.bookId is string
        && d.startedAt is timestamp && d.createdAt is timestamp && d.updatedAt is timestamp
        && (d.status == 'READING' || (d.status == 'COMPLETED'
          && d.finishedAt is timestamp && d.finishedAt >= d.startedAt
          && d.rating is int && d.rating >= 1 && d.rating <= 5
          && d.completedAt is timestamp))
        && (!('review' in d) || (d.review is string && d.review.size() <= 10000));
    }
    match /users/{uid}/books/{bookId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.id == bookId
        && request.resource.data.title is string && request.resource.data.authors is list
        && request.resource.data.pageCount is number && request.resource.data.pageCount > 0;
    }
    match /users/{uid}/records/{recordId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validRecord(uid)
        && request.resource.data.id == recordId && request.resource.data.status == 'READING'
        && existsAfter(/databases/$(database)/documents/users/$(uid)/books/$(request.resource.data.bookId));
      allow update: if owner(uid) && validRecord(uid)
        && request.resource.data.id == resource.data.id
        && request.resource.data.bookId == resource.data.bookId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.userId == resource.data.userId
        && (resource.data.status != 'COMPLETED' || (request.resource.data.status == 'COMPLETED'
          && request.resource.data.completedAt == resource.data.completedAt));
    }
  }
}
